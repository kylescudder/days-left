{
    admin off
    auto_https off
    persist_config off
}
:8080 {
    encode zstd gzip
    header X-Days-Left-Revision {$DAYS_LEFT_REVISION}
    handle /healthz {
        header Cache-Control no-store
        header Content-Type application/json
        respond `{"ok":true,"revision":"{$DAYS_LEFT_REVISION}"}` 200
    }
    handle {
        root * /srv
        header /_astro/* Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
}
