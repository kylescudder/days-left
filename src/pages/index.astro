---
import { Image } from 'astro:assets';
import otterFamily from '../assets/otter-family.png';

const targetLabel = '4:00pm on Friday, 29 January 2027';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="A gentle countdown to maternity leave." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Libre+Caslon+Display&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet" />
    <title>Nearly there, my love</title>
  </head>
  <body>
    <main>
      <div class="leaf-shadow leaf-shadow--left" aria-hidden="true"></div>
      <div class="leaf-shadow leaf-shadow--right" aria-hidden="true"></div>

      <section class="nursery" aria-labelledby="page-title">
        <div class="art-wall">
          <div class="frame-wrap">
            <span class="tape tape--one" aria-hidden="true"></span>
            <span class="tape tape--two" aria-hidden="true"></span>
            <figure class="frame">
              <div class="mat">
                <Image
                  src={otterFamily}
                  alt="Two parent otters floating with their baby"
                  widths={[240, 340, 480, 680]}
                  sizes="(max-width: 500px) 72vw, 340px"
                  quality={80}
                  loading="eager"
                  fetchpriority="high"
                />
              </div>
            </figure>
            <p class="frame-note">our little family is waiting</p>
          </div>

          <div class="shelf" aria-hidden="true">
            <div class="plant">
              <span class="stem stem--one"><i></i><i></i><i></i></span>
              <span class="stem stem--two"><i></i><i></i></span>
              <span class="stem stem--three"><i></i><i></i><i></i></span>
              <span class="pot"></span>
            </div>
            <div class="books"><span></span><span></span><span></span></div>
            <div class="little-hedgehog little-hedgehog--shelf">
              <span class="spines"></span><span class="face"></span><i class="eye"></i><i class="nose"></i>
            </div>
          </div>
        </div>

        <header class="intro">
          <p class="eyebrow"><span></span> The home stretch <span></span></p>
          <h1 id="page-title">Nearly there,<br /><em>my love.</em></h1>
          <p class="lede">Every minute is one closer to putting work away<br class="desktop-only" /> and starting our sweetest chapter yet.</p>
        </header>

        <section class="countdown-card" aria-label={`Countdown to ${targetLabel}`}>
          <span class="stitch stitch--top" aria-hidden="true"></span>
          <div class="countdown" role="timer">
            <div class="time-unit">
              <strong id="days">---</strong>
              <span>days</span>
            </div>
            <span class="divider">:</span>
            <div class="time-unit">
              <strong id="hours">--</strong>
              <span>hours</span>
            </div>
            <span class="divider">:</span>
            <div class="time-unit">
              <strong id="minutes">--</strong>
              <span>mins</span>
            </div>
            <span class="divider divider--seconds">:</span>
            <div class="time-unit time-unit--seconds">
              <strong id="seconds">--</strong>
              <span>secs</span>
            </div>
          </div>
          <p class="date"><span aria-hidden="true">✦</span> until {targetLabel} <span aria-hidden="true">✦</span></p>
          <p id="countdown-status" class="sr-only" role="status" aria-live="polite"></p>
          <span class="stitch stitch--bottom" aria-hidden="true"></span>
        </section>

        <footer>
          <div class="little-hedgehog little-hedgehog--floor" aria-hidden="true">
            <span class="spines"></span><span class="face"></span><i class="eye"></i><i class="nose"></i>
          </div>
          <p>One day at a time. You've got this.</p>
          <svg class="sprig" viewBox="0 0 110 32" aria-hidden="true">
            <path d="M3 28C30 7 58 10 106 4" />
            <path d="M27 18C16 17 13 10 13 5c8 1 13 5 14 13Zm19-7C39 7 38 1 39 0c8 2 10 6 7 11Zm18-1c4-8 9-9 15-9-1 8-7 10-15 9Zm17-3c5 1 9 5 10 11-7 0-11-4-10-11Z" />
          </svg>
        </footer>
      </section>
    </main>

    <script>
      import { getCountdownValues } from '../lib/countdown';

      const elements = {
        days: document.querySelector('#days'),
        hours: document.querySelector('#hours'),
        minutes: document.querySelector('#minutes'),
        seconds: document.querySelector('#seconds'),
      };

      function updateCountdown() {
        const { distance, ...values } = getCountdownValues();

        Object.entries(values).forEach(([key, value]) => {
          const el = elements[key as keyof typeof elements];
          if (el) el.textContent = key === 'days' ? String(value) : String(value).padStart(2, '0');
        });

        if (distance === 0) {
          document.querySelector('.countdown-card')?.classList.add('is-finished');
          document.querySelector('.date')!.textContent = 'You made it — maternity leave begins!';
          document.querySelector('#countdown-status')!.textContent = 'You made it — maternity leave begins!';
        }
      }

      updateCountdown();
      window.setInterval(updateCountdown, 1000);
    </script>
  </body>
</html>

<style is:global>
  :root {
    --cream: #f4efe3;
    --paper: #f9f5e9;
    --sage: #aab796;
    --sage-deep: #68765c;
    --moss: #4d5b45;
    --clay: #a87b5b;
    --brown: #5b4638;
    --ink: #34372f;
  }

  * { box-sizing: border-box; }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  html { min-width: 320px; background: var(--cream); }

  body {
    margin: 0;
    color: var(--ink);
    font-family: 'Nunito', sans-serif;
  }

  body::before {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: .24;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.18'/%3E%3C/svg%3E");
    mix-blend-mode: multiply;
    z-index: 20;
  }

  main {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background:
      radial-gradient(circle at 78% 18%, rgba(255,255,255,.78), transparent 34%),
      linear-gradient(155deg, #e7ead9 0%, var(--cream) 40%, #eee4d4 100%);
  }

  main::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 8px;
    background: repeating-linear-gradient(90deg, #8f684b 0 70px, #805d44 70px 71px);
    opacity: .65;
  }

  .nursery {
    position: relative;
    width: min(1180px, calc(100% - 48px));
    min-height: 100vh;
    margin: 0 auto;
    padding: 54px 0 46px;
    display: grid;
    grid-template-columns: .87fr 1.13fr;
    grid-template-rows: auto auto auto;
    column-gap: clamp(48px, 7vw, 110px);
    align-content: center;
    align-items: center;
  }

  .art-wall { grid-row: 1 / 4; align-self: center; position: relative; padding-bottom: 56px; }

  .frame-wrap { position: relative; width: min(100%, 340px); margin: 0 auto; transform: rotate(-1.2deg); }

  .frame {
    margin: 0;
    padding: 16px;
    background: linear-gradient(135deg, #735138, #9b7655 34%, #64462f 100%);
    border: 2px solid #4a3628;
    border-radius: 3px;
    box-shadow: 6px 11px 25px rgba(66,49,36,.25), inset 0 0 0 3px rgba(255,255,255,.13);
  }

  .mat { padding: 20px; background: #efe8d8; box-shadow: inset 0 0 0 1px rgba(72,58,44,.16); }
  .mat img { display: block; width: 100%; height: auto; aspect-ratio: 2 / 3; object-fit: cover; filter: saturate(.88) contrast(.96); }

  .frame-note {
    margin: 14px 0 0;
    color: var(--sage-deep);
    font-family: 'Libre Caslon Display', serif;
    font-size: 1rem;
    font-style: italic;
    letter-spacing: .04em;
    text-align: center;
  }

  .tape { position: absolute; width: 80px; height: 28px; z-index: 2; background: rgba(224,218,183,.68); box-shadow: 0 1px 3px rgba(70,60,46,.12); }
  .tape--one { top: -7px; left: -29px; transform: rotate(-39deg); }
  .tape--two { right: -28px; bottom: 35px; transform: rotate(-42deg); }

  .shelf {
    position: absolute;
    left: -30px;
    right: -28px;
    bottom: 14px;
    height: 22px;
    border-radius: 3px 3px 8px 8px;
    background: linear-gradient(#a67c59, #805b40);
    box-shadow: 0 12px 16px rgba(61,42,29,.25), inset 0 2px rgba(255,255,255,.22);
  }

  .shelf::before, .shelf::after { content: ''; position: absolute; top: 19px; width: 28px; height: 32px; background: #76533b; clip-path: polygon(0 0,100% 0,74% 100%,28% 100%); }
  .shelf::before { left: 45px; } .shelf::after { right: 45px; }

  .plant { position: absolute; left: 25px; bottom: 18px; width: 90px; height: 102px; }
  .pot { position: absolute; bottom: 0; left: 23px; width: 50px; height: 41px; background: var(--clay); clip-path: polygon(4% 0,96% 0,82% 100%,19% 100%); border-radius: 4px; }
  .stem { position: absolute; bottom: 38px; left: 47px; width: 2px; height: 64px; background: var(--moss); transform-origin: bottom; }
  .stem--one { transform: rotate(-29deg); height: 55px; } .stem--three { transform: rotate(28deg); height: 50px; }
  .stem i { position: absolute; width: 25px; height: 12px; background: var(--sage-deep); border-radius: 100% 0 100% 0; }
  .stem i:nth-child(1) { top: 8px; left: 0; transform: rotate(-30deg); }
  .stem i:nth-child(2) { top: 25px; right: 1px; transform: scaleX(-1) rotate(-30deg); }
  .stem i:nth-child(3) { top: 42px; left: 0; transform: rotate(-30deg); }

  .books { position: absolute; right: 24px; bottom: 21px; height: 64px; display: flex; gap: 4px; align-items: end; }
  .books span { width: 17px; height: 58px; border-radius: 2px 3px 0 0; background: #7e8d70; box-shadow: inset 3px 0 rgba(255,255,255,.12); }
  .books span:nth-child(2) { height: 51px; background: #bd9270; transform: rotate(4deg); transform-origin: bottom; }
  .books span:nth-child(3) { height: 62px; background: #d4c59f; }

  .intro { align-self: end; text-align: center; animation: rise .8s .1s both ease-out; }
  .eyebrow { display: flex; align-items: center; justify-content: center; gap: 15px; margin: 0 0 20px; color: var(--sage-deep); font-size: .68rem; font-weight: 700; letter-spacing: .29em; text-transform: uppercase; }
  .eyebrow span { width: 34px; height: 1px; background: currentColor; opacity: .6; }

  h1 { margin: 0; color: var(--brown); font-family: 'Libre Caslon Display', serif; font-size: clamp(4.4rem, 7.2vw, 7rem); font-weight: 400; line-height: .76; letter-spacing: -.055em; }
  h1 em { position: relative; color: var(--sage-deep); font-weight: 400; }
  h1 em::after { content: ''; position: absolute; left: 6%; right: -2%; bottom: -9px; height: 7px; border-top: 2px solid #a5ad86; border-radius: 50%; transform: rotate(-2deg); }
  .lede { margin: 32px 0 30px; color: #687060; font-size: clamp(.95rem, 1.4vw, 1.08rem); line-height: 1.75; }

  .countdown-card {
    position: relative;
    align-self: center;
    width: min(100%, 650px);
    padding: 27px 34px 23px;
    border-radius: 30px 8px 30px 8px;
    background: var(--sage-deep);
    box-shadow: 0 19px 45px rgba(67,78,58,.22), inset 0 0 0 1px rgba(255,255,255,.12);
    color: #fbf7eb;
    transform: rotate(.45deg);
    animation: rise .8s .25s both ease-out;
  }

  .countdown { display: flex; align-items: flex-start; justify-content: center; gap: clamp(7px, 1.2vw, 16px); }
  .time-unit { min-width: 77px; text-align: center; }
  .time-unit strong { display: block; font-family: 'DM Mono', monospace; font-size: clamp(2.4rem, 5vw, 4.2rem); font-weight: 400; line-height: 1; letter-spacing: -.09em; font-variant-numeric: tabular-nums; }
  .time-unit span { display: block; margin-top: 10px; color: #dce2cd; font-size: .59rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; }
  .divider { margin-top: 2px; color: #c5cfb1; font-family: 'Libre Caslon Display', serif; font-size: clamp(2.1rem, 4vw, 3.6rem); line-height: 1; opacity: .55; }
  .date { margin: 20px 0 0; display: flex; justify-content: center; gap: 11px; color: #e5e8d7; font-family: 'Libre Caslon Display', serif; font-size: .92rem; letter-spacing: .06em; }
  .date span { color: #c8b68c; }
  .stitch { position: absolute; left: 15px; right: 15px; height: 1px; border-top: 1px dashed rgba(239,237,214,.32); }
  .stitch--top { top: 11px; } .stitch--bottom { bottom: 11px; }

  .is-finished .countdown { display: none; }
  .is-finished .date { margin: 10px 0; font-size: 1.3rem; }

  footer { align-self: start; position: relative; padding-top: 31px; text-align: center; animation: rise .8s .38s both ease-out; }
  footer p { margin: 0; color: var(--brown); font-family: 'Libre Caslon Display', serif; font-size: 1.08rem; font-style: italic; }
  .sprig { width: 78px; margin-top: 12px; fill: var(--sage); stroke: var(--sage-deep); stroke-width: 1.5; stroke-linecap: round; }

  .little-hedgehog { position: absolute; width: 70px; height: 42px; }
  .little-hedgehog .spines { position: absolute; inset: 0 18px 0 0; border-radius: 65% 55% 15% 25%; background: var(--brown); clip-path: polygon(0 48%,8% 22%,16% 34%,26% 8%,35% 29%,49% 0,56% 27%,70% 5%,72% 34%,91% 23%,86% 51%,100% 65%,94% 100%,12% 100%); }
  .little-hedgehog .face { position: absolute; right: 4px; bottom: 0; width: 42px; height: 31px; border-radius: 70% 80% 50% 60%; background: #c09a72; transform: rotate(3deg); }
  .little-hedgehog .eye { position: absolute; right: 19px; bottom: 17px; width: 4px; height: 4px; border-radius: 50%; background: #302821; }
  .little-hedgehog .nose { position: absolute; right: 0; bottom: 10px; width: 7px; height: 6px; border-radius: 50%; background: #302821; }
  .little-hedgehog--shelf { right: 94px; bottom: 21px; transform: scale(.72); transform-origin: bottom; }
  .little-hedgehog--floor { right: 5%; top: 24px; transform: scale(.78) rotate(-4deg); opacity: .8; }

  .leaf-shadow { position: absolute; width: 350px; height: 700px; opacity: .09; filter: blur(2px); transform: rotate(18deg); }
  .leaf-shadow::before, .leaf-shadow::after { content: ''; position: absolute; width: 100%; height: 100%; background: repeating-radial-gradient(ellipse at 30% 20%, var(--moss) 0 22px, transparent 24px 58px); clip-path: polygon(42% 0,58% 0,62% 100%,48% 100%); }
  .leaf-shadow--left { left: -120px; top: -80px; } .leaf-shadow--right { right: -180px; bottom: -260px; transform: rotate(-28deg); }

  @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }

  @media (max-width: 800px) {
    .nursery { width: min(100% - 34px, 620px); padding: 38px 0 46px; display: flex; flex-direction: column; }
    .art-wall { width: min(76vw, 340px); order: 0; margin-bottom: 30px; }
    .intro { order: 1; width: 100%; align-self: center; }
    .countdown-card { order: 2; margin-top: 4px; padding-left: 18px; padding-right: 18px; }
    footer { order: 3; width: 100%; align-self: center; }
    h1 { font-size: clamp(4rem, 17vw, 6rem); }
    .lede { margin-top: 28px; }
    .shelf { left: -18px; right: -18px; }
    .tape--one { left: -17px; }
    .tape--two { right: -17px; }
  }

  @media (max-width: 500px) {
    .nursery { width: min(100% - 24px, 440px); }
    .art-wall { width: min(72vw, 310px); padding-bottom: 42px; }
    .frame { padding: 10px; }
    .mat { padding: 11px; }
    .frame-note { font-size: .82rem; }
    .shelf { bottom: 8px; height: 17px; }
    .plant { transform: scale(.7); transform-origin: left bottom; bottom: 13px; }
    .books { transform: scale(.72); transform-origin: right bottom; bottom: 15px; }
    .little-hedgehog--shelf { bottom: 15px; right: 61px; transform: scale(.52); }
    .eyebrow { margin-bottom: 18px; }
    h1 { line-height: .82; }
    .lede { font-size: .9rem; line-height: 1.65; }
    .desktop-only { display: none; }
    .countdown-card { border-radius: 22px 6px; padding: 24px 11px 21px; }
    .countdown { gap: 3px; }
    .time-unit { min-width: 53px; }
    .time-unit strong { font-size: clamp(2rem, 10vw, 2.7rem); }
    .time-unit span { margin-top: 8px; font-size: .49rem; letter-spacing: .12em; }
    .divider { font-size: 2rem; }
    .date { margin-top: 17px; gap: 7px; font-size: .72rem; }
    .little-hedgehog--floor { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; }
  }
</style>
