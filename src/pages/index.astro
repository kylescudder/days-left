---
import { Image } from 'astro:assets'
import otterFamily from '../assets/otter-family.png'
import Hedgehog from '../components/Hedgehog.astro'
import '../styles/global.css'

const targetLabel = '4:00pm on Friday, 29 January 2027'

const timeUnits = [
  { id: 'days', label: 'days', placeholder: '---' },
  { id: 'hours', label: 'hours', placeholder: '--' },
  { id: 'minutes', label: 'mins', placeholder: '--' },
  { id: 'seconds', label: 'secs', placeholder: '--' }
]

const leafShadow =
  'absolute h-[700px] w-[350px] opacity-9 blur-[2px] before:absolute before:size-full before:bg-[repeating-radial-gradient(ellipse_at_30%_20%,var(--color-moss)_0_22px,transparent_24px_58px)] before:[clip-path:polygon(42%_0,58%_0,62%_100%,48%_100%)] after:absolute after:size-full after:bg-[repeating-radial-gradient(ellipse_at_30%_20%,var(--color-moss)_0_22px,transparent_24px_58px)] after:[clip-path:polygon(42%_0,58%_0,62%_100%,48%_100%)]'
const tape =
  'absolute z-2 h-7 w-20 bg-[rgba(224,218,183,0.68)] shadow-[0_1px_3px_rgba(70,60,46,0.12)]'
const stem = 'absolute bottom-[38px] left-[47px] w-0.5 origin-bottom bg-moss'
const leaf = 'absolute h-3 w-[25px] rounded-[100%_0_100%_0] bg-sage-deep'
const book =
  'w-[17px] rounded-[2px_3px_0_0] shadow-[inset_3px_0_rgba(255,255,255,0.12)]'
const eyebrowRule = 'h-px w-[34px] bg-current opacity-60'
---

<!doctype html>
<html lang='en' class='min-w-[320px] bg-cream leading-[normal]'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width' />
    <meta name='description' content='A gentle countdown to maternity leave.' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link
      href='https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Libre+Caslon+Display&family=Nunito:wght@400;600;700&display=swap'
      rel='stylesheet'
    />
    <title>Nearly there, my love</title>
  </head>
  <body class='font-sans text-ink before:pointer-events-none before:fixed before:inset-0 before:z-20 before:bg-(image:--image-paper-grain) before:opacity-24 before:mix-blend-multiply'>
    <main class='relative min-h-screen overflow-hidden bg-[radial-gradient(circle_at_78%_18%,rgba(255,255,255,0.78),transparent_34%),linear-gradient(155deg,#e7ead9_0%,var(--color-cream)_40%,#eee4d4_100%)] after:absolute after:inset-x-0 after:bottom-0 after:h-2 after:bg-[repeating-linear-gradient(90deg,#8f684b_0_70px,#805d44_70px_71px)] after:opacity-65'>
      <div
        class:list={[leafShadow, '-top-20 -left-[120px] rotate-18']}
        aria-hidden='true'
      ></div>
      <div
        class:list={[leafShadow, '-right-[180px] -bottom-[260px] -rotate-28']}
        aria-hidden='true'
      ></div>

      <section
        class='relative mx-auto grid min-h-screen w-[min(1180px,calc(100%-48px))] grid-cols-[0.87fr_1.13fr] grid-rows-[auto_auto_auto] content-center items-center gap-x-[clamp(48px,7vw,110px)] pt-[54px] pb-[46px] tablet:flex tablet:w-[min(100%-34px,620px)] tablet:flex-col tablet:pt-[38px] phone:w-[min(100%-24px,440px)]'
        aria-labelledby='page-title'
      >
        <div class='relative row-[1/4] self-center pb-14 tablet:order-none tablet:mb-[30px] tablet:w-[min(76vw,340px)] phone:w-[min(72vw,310px)] phone:pb-[42px]'>
          <div class='relative mx-auto w-[min(100%,340px)] -rotate-[1.2deg]'>
            <span
              class:list={[
                tape,
                '-top-[7px] -left-[29px] -rotate-39 tablet:-left-[17px]'
              ]}
              aria-hidden='true'
            ></span>
            <span
              class:list={[
                tape,
                '-right-[28px] bottom-[35px] -rotate-42 tablet:-right-[17px]'
              ]}
              aria-hidden='true'
            ></span>
            <figure class='rounded-[3px] border-2 border-[#4a3628] bg-[linear-gradient(135deg,#735138,#9b7655_34%,#64462f_100%)] p-4 shadow-[6px_11px_25px_rgba(66,49,36,0.25),inset_0_0_0_3px_rgba(255,255,255,0.13)] phone:p-2.5'>
              <div class='bg-[#efe8d8] p-5 shadow-[inset_0_0_0_1px_rgba(72,58,44,0.16)] phone:p-[11px]'>
                <Image
                  src={otterFamily}
                  alt='Two parent otters floating with their baby'
                  widths={[240, 340, 480, 680]}
                  sizes='(max-width: 500px) 72vw, 340px'
                  quality={80}
                  loading='eager'
                  fetchpriority='high'
                  class='block aspect-[2/3] h-auto w-full object-cover [filter:saturate(0.88)_contrast(0.96)]'
                />
              </div>
            </figure>
            <p class='mt-3.5 text-center font-display text-[1rem] tracking-[0.04em] text-sage-deep italic phone:text-[0.82rem]'>
              our little family is waiting
            </p>
          </div>

          <div
            class='absolute -right-[28px] bottom-3.5 -left-[30px] h-[22px] rounded-t-[3px] rounded-b-[8px] bg-[linear-gradient(#a67c59,#805b40)] shadow-[0_12px_16px_rgba(61,42,29,0.25),inset_0_2px_rgba(255,255,255,0.22)] before:absolute before:top-[19px] before:left-[45px] before:h-8 before:w-7 before:bg-[#76533b] before:[clip-path:polygon(0_0,100%_0,74%_100%,28%_100%)] after:absolute after:top-[19px] after:right-[45px] after:h-8 after:w-7 after:bg-[#76533b] after:[clip-path:polygon(0_0,100%_0,74%_100%,28%_100%)] tablet:-right-[18px] tablet:-left-[18px] phone:bottom-2 phone:h-[17px]'
            aria-hidden='true'
          >
            <div class='absolute bottom-[18px] left-[25px] h-[102px] w-[90px] phone:bottom-[13px] phone:origin-bottom-left phone:scale-70'>
              <span class:list={[stem, 'h-[55px] -rotate-29']}>
                <i class:list={[leaf, 'top-2 left-0 -rotate-30']}></i>
                <i
                  class:list={[
                    leaf,
                    'top-[25px] right-px [transform:scaleX(-1)_rotate(-30deg)]'
                  ]}
                ></i>
                <i class:list={[leaf, 'top-[42px] left-0 -rotate-30']}></i>
              </span>
              <span class:list={[stem, 'h-16']}>
                <i class:list={[leaf, 'top-2 left-0 -rotate-30']}></i>
                <i
                  class:list={[
                    leaf,
                    'top-[25px] right-px [transform:scaleX(-1)_rotate(-30deg)]'
                  ]}
                ></i>
              </span>
              <span class:list={[stem, 'h-[50px] rotate-28']}>
                <i class:list={[leaf, 'top-2 left-0 -rotate-30']}></i>
                <i
                  class:list={[
                    leaf,
                    'top-[25px] right-px [transform:scaleX(-1)_rotate(-30deg)]'
                  ]}
                ></i>
                <i class:list={[leaf, 'top-[42px] left-0 -rotate-30']}></i>
              </span>
              <span class='absolute bottom-0 left-[23px] h-[41px] w-[50px] rounded-sm bg-clay [clip-path:polygon(4%_0,96%_0,82%_100%,19%_100%)]'></span>
            </div>
            <div class='absolute right-6 bottom-[21px] flex h-16 items-end gap-1 phone:bottom-[15px] phone:origin-bottom-right phone:scale-72'>
              <span class:list={[book, 'h-[58px] bg-[#7e8d70]']}></span>
              <span
                class:list={[
                  book,
                  'h-[51px] origin-bottom rotate-4 bg-[#bd9270]'
                ]}
              ></span>
              <span class:list={[book, 'h-[62px] bg-[#d4c59f]']}></span>
            </div>
            <Hedgehog class='right-[94px] bottom-[21px] origin-bottom scale-72 phone:right-[61px] phone:bottom-[15px] phone:scale-52' />
          </div>
        </div>

        <header class='animate-[rise_0.8s_0.1s_both_ease-out] self-end text-center tablet:order-1 tablet:w-full tablet:self-center'>
          <p class='mb-5 flex items-center justify-center gap-[15px] text-[0.68rem] font-bold tracking-[0.29em] text-sage-deep uppercase phone:mb-[18px]'>
            <span class={eyebrowRule}></span> The home stretch{' '}
            <span class={eyebrowRule}></span>
          </p>
          <h1
            id='page-title'
            class='font-display text-[length:clamp(4.4rem,7.2vw,7rem)] leading-[0.76] font-normal tracking-[-0.055em] text-brown tablet:text-[length:clamp(4rem,17vw,6rem)] phone:leading-[0.82]'
          >
            Nearly there,
            <br />
            <em class='relative font-normal text-sage-deep after:absolute after:-right-[2%] after:-bottom-[9px] after:left-[6%] after:box-content after:h-[7px] after:-rotate-2 after:rounded-[50%] after:border-t-2 after:border-[#a5ad86]'>
              my love.
            </em>
          </h1>
          <p class='mt-8 mb-[30px] text-[length:clamp(0.95rem,1.4vw,1.08rem)] leading-[1.75] text-[#687060] tablet:mt-7 phone:text-[0.9rem] phone:leading-[1.65]'>
            Every minute is one closer to putting work away
            <br class='phone:hidden' /> and starting our sweetest chapter yet.
          </p>
        </header>

        <section
          id='countdown-card'
          class='group relative w-[min(100%,650px)] animate-[rise_0.8s_0.25s_both_ease-out] self-center rounded-[30px_8px_30px_8px] bg-sage-deep px-[34px] pt-[27px] pb-[23px] text-[#fbf7eb] shadow-[0_19px_45px_rgba(67,78,58,0.22),inset_0_0_0_1px_rgba(255,255,255,0.12)] tablet:order-2 tablet:mt-1 tablet:px-[18px] phone:rounded-[22px_6px] phone:px-[11px] phone:pt-6 phone:pb-[21px]'
          aria-label={`Countdown to ${targetLabel}`}
        >
          <span
            class='absolute inset-x-[15px] top-[11px] h-px border-t border-dashed border-[rgba(239,237,214,0.32)]'
            aria-hidden='true'
          ></span>
          <div
            class='flex items-start justify-center gap-[clamp(7px,1.2vw,16px)] group-data-finished:hidden phone:gap-[3px]'
            role='timer'
          >
            {timeUnits.map(({ id, label, placeholder }, index) => (
              <>
                {index > 0 && (
                  <span class='mt-0.5 font-display text-[length:clamp(2.1rem,4vw,3.6rem)] leading-none text-[#c5cfb1] opacity-55 phone:text-[2rem]'>
                    :
                  </span>
                )}
                <div class='min-w-[77px] text-center phone:min-w-[53px]'>
                  <strong
                    id={id}
                    class='block font-mono text-[length:clamp(2.4rem,5vw,4.2rem)] leading-none font-normal tracking-[-0.09em] tabular-nums phone:text-[length:clamp(2rem,10vw,2.7rem)]'
                  >
                    {placeholder}
                  </strong>
                  <span class='mt-2.5 block text-[0.59rem] font-bold tracking-[0.2em] text-[#dce2cd] uppercase phone:mt-2 phone:text-[0.49rem] phone:tracking-[0.12em]'>
                    {label}
                  </span>
                </div>
              </>
            ))}
          </div>
          <p
            id='countdown-date'
            class='mt-5 flex justify-center gap-[11px] font-display text-[0.92rem] tracking-[0.06em] text-[#e5e8d7] group-data-finished:my-2.5 group-data-finished:text-[1.3rem] phone:mt-[17px] phone:gap-[7px] phone:text-[0.72rem]'
          >
            <span class='text-[#c8b68c]' aria-hidden='true'>
              ✦
            </span>{' '}
            until {targetLabel}{' '}
            <span class='text-[#c8b68c]' aria-hidden='true'>
              ✦
            </span>
          </p>
          <p
            id='countdown-status'
            class='sr-only'
            role='status'
            aria-live='polite'
          ></p>
          <span
            class='absolute inset-x-[15px] bottom-[11px] h-px border-t border-dashed border-[rgba(239,237,214,0.32)]'
            aria-hidden='true'
          ></span>
        </section>

        <footer class='relative animate-[rise_0.8s_0.38s_both_ease-out] self-start pt-[31px] text-center tablet:order-3 tablet:w-full tablet:self-center'>
          <Hedgehog
            class='top-6 right-[5%] scale-78 -rotate-4 opacity-80 phone:hidden'
            aria-hidden='true'
          />
          <p class='font-display text-[1.08rem] text-brown italic'>
            One day closer to our sweetest chapter.
          </p>
          <svg
            class='mt-3 inline w-[78px] fill-sage stroke-sage-deep stroke-[1.5] align-baseline [stroke-linecap:round]'
            viewBox='0 0 110 32'
            aria-hidden='true'
          >
            <path d='M3 28C30 7 58 10 106 4'></path>
            <path d='M27 18C16 17 13 10 13 5c8 1 13 5 14 13Zm19-7C39 7 38 1 39 0c8 2 10 6 7 11Zm18-1c4-8 9-9 15-9-1 8-7 10-15 9Zm17-3c5 1 9 5 10 11-7 0-11-4-10-11Z'></path>
          </svg>
        </footer>
      </section>
    </main>

    <script>
      import { getCountdownValues } from '../lib/countdown'

      const elements = {
        days: document.querySelector('#days'),
        hours: document.querySelector('#hours'),
        minutes: document.querySelector('#minutes'),
        seconds: document.querySelector('#seconds')
      }

      function updateCountdown() {
        const { distance, ...values } = getCountdownValues()

        Object.entries(values).forEach(([key, value]) => {
          const el = elements[key as keyof typeof elements]
          if (el)
            el.textContent =
              key === 'days' ? String(value) : String(value).padStart(2, '0')
        })

        if (distance === 0) {
          document
            .querySelector('#countdown-card')
            ?.setAttribute('data-finished', '')
          document.querySelector('#countdown-date')!.textContent =
            'You made it — maternity leave begins!'
          document.querySelector('#countdown-status')!.textContent =
            'You made it — maternity leave begins!'
        }
      }

      updateCountdown()
      window.setInterval(updateCountdown, 1000)
    </script>
  </body>
</html>
